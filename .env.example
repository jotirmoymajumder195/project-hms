# HMS — Docker Compose Environment Variables
# Copy this file to .env at the project root and adjust values.
# Docker Compose reads .env automatically from the same directory.

# Backend URL the frontend talks to.
# Local dev: http://localhost:5000/api/v1
# Behind Nginx: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Production database URL (RDS)
DATABASE_URL=postgresql://hms_user:strongpassword@your-rds-endpoint:5432/hms_db
